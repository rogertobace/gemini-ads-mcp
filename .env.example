# Gemini: secret server-side key. Never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=

# Optional: keep configurable so the model can be upgraded without code changes.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Private single-tenant OAuth credentials used by the ChatGPT MCP connection.
MCP_OAUTH_CLIENT_ID=chatgpt-gemini-ads
MCP_OAUTH_CLIENT_SECRET=
MCP_AUTH_SECRET=

# Comma-separated origins accepted as OAuth redirect destinations.
MCP_ALLOWED_REDIRECT_ORIGINS=https://chatgpt.com,https://platform.openai.com

# Optional fixed public origin. On Vercel it is inferred automatically.
MCP_PUBLIC_URL=
